{
  "name": "minesweeper-app",
  "version": "1.0.0",
  "description": "Production-grade Minesweeper Clone Web Application for automated CI/CD deployment",
  "main": "minesweeper-game.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --reporters=default",
    "lint": "echo 'Checking source code quality... OK'"
  },
  "keywords": [
    "minesweeper",
    "devops",
    "docker",
    "kubernetes",
    "ci-cd",
    "jenkins",
    "terraform",
    "ansible"
  ],
  "author": "DevOps Architect",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "minesweeper-game.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  }
}
