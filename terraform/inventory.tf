# ========================================================
# Automated Ansible Inventory Generator
# Converts Terraform provisioned EC2 IPs directly into hosts.ini
# ========================================================

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/hosts.ini"
  file_permission = "0644"
  content         = <<-EOT
# Automated Inventory generated by Terraform
# Do not edit manually - provisioned via 'terraform apply'

[k3s_master]
master ansible_host=${aws_instance.k3s_master.public_ip} private_ip=${aws_instance.k3s_master.private_ip} node_name=k3s-master

[k3s_workers]
%{ for index, worker in aws_instance.k3s_workers ~}
worker-${index + 1} ansible_host=${worker.public_ip} private_ip=${worker.private_ip} node_name=k3s-worker-${index + 1}
%{ endfor ~}

[k3s_cluster:children]
k3s_master
k3s_workers

%{ if var.enable_jenkins_ec2 ~}
[jenkins]
jenkins ansible_host=${aws_instance.jenkins_server[0].public_ip}
%{ endif ~}

[all:vars]
ansible_user=ubuntu
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_python_interpreter=/usr/bin/python3
%{ if length(tls_private_key.minesweeper_key) > 0 ~}
ansible_ssh_private_key_file=./id_rsa_minesweeper
%{ endif ~}
EOT
}
